// The real machine hostname (mounted from /etc/hostname). constants.hostname
// returns the container's own hostname (e.g. "alloy-vo1c"), not the machine's.
local.file "hostname" {
	filename = "/etc/host_hostname"
}

// Discover all containers on this host via the Docker socket.
discovery.docker "containers" {
	host = "unix:///var/run/docker.sock"
}

// Turn the Docker container name (e.g. "/groceries-app-1") into a clean
// "container" label (e.g. "groceries-app-1").
discovery.relabel "containers" {
	targets = discovery.docker.containers.targets

	rule {
		source_labels = ["__meta_docker_container_name"]
		regex         = "/(.*)"
		target_label  = "container"
	}
}

// Tail each discovered container's logs and forward them to Loki.
loki.source.docker "containers" {
	host       = "unix:///var/run/docker.sock"
	targets    = discovery.relabel.containers.output
	forward_to = [loki.write.default.receiver]
}

// Ship logs to Grafana Cloud. Reading the host's hostname keeps this file
// identical on every host while still labeling logs by their source machine.
loki.write "default" {
	endpoint {
		url = sys.env("GRAFANA_CLOUD_LOKI_URL")

		basic_auth {
			username = sys.env("GRAFANA_CLOUD_LOKI_USER")
			password = sys.env("GRAFANA_CLOUD_TOKEN")
		}
	}

	external_labels = {
		host = string.trim_space(local.file.hostname.content),
	}
}

// Receive OTLP metrics and traces from local applications over gRPC (4317) and HTTP (4318),
// the OpenTelemetry defaults. Apps on this host point their exporter at
// localhost and Alloy handles shipping to the central backend.
otelcol.receiver.otlp "default" {
	grpc {
		endpoint = "0.0.0.0:4317"
	}

	http {
		endpoint = "0.0.0.0:4318"
	}

	output {
		traces = [otelcol.processor.attributes.default.input]
		metrics = [otelcol.exporter.prometheus.default.input]
	}
}

// Stamp every span with the source machine so traces can be correlated with
// logs (which carry the matching "host" label). Mirrors loki.write above.
otelcol.processor.attributes "default" {
	action {
		key    = "host.name"
		value  = string.trim_space(local.file.hostname.content)
		action = "upsert"
	}

	output {
		traces = [otelcol.processor.filter.drop_ping.input]
	}
}

// Drop healthcheck "ping" spans; they are noise and don't need observability.
otelcol.processor.filter "drop_ping" {
	error_mode = "ignore"

	traces {
		span = [
			`IsMatch(name, "(?i)^ping$")`,
		]
	}

	output {
		traces = [otelcol.processor.batch.default.input]
	}
}

// Batch spans before shipping to cut network overhead.
otelcol.processor.batch "default" {
	output {
		traces = [otelcol.exporter.otlp.grafana_cloud.input]
	}
}

// Ship traces to Grafana Cloud Tempo. The endpoint must be
// host:port with no scheme, e.g. "tempo-prod-XX-prod-REGION.grafana.net:443".
otelcol.auth.basic "grafana_cloud" {
	username = sys.env("GRAFANA_CLOUD_TEMPO_USER")
	password = sys.env("GRAFANA_CLOUD_TOKEN")
}

otelcol.exporter.otlp "grafana_cloud" {
	client {
		endpoint = sys.env("GRAFANA_CLOUD_TEMPO_URL")
		auth     = otelcol.auth.basic.grafana_cloud.handler
	}
}

// Convert OTLP metrics to Prometheus format
otelcol.exporter.prometheus "default" {
	forward_to = [prometheus.remote_write.grafana_cloud.receiver]
}

// Grafana Cloud Prometheus. Receives scraped host/container metrics and the
// OTLP metrics above.
prometheus.remote_write "grafana_cloud" {
	endpoint {
		url = sys.env("GRAFANA_CLOUD_PROM_URL")

		basic_auth {
			username = sys.env("GRAFANA_CLOUD_PROM_USER")
			password = sys.env("GRAFANA_CLOUD_TOKEN")
		}
	}
}

// ---- Host metrics (replaces the standalone node_exporter) ----
prometheus.exporter.unix "node" {
	rootfs_path = "/proc/1/root"
}

// job/instance match the old Prometheus scrape config so the dashboard and the
// `up{job="node"}` alert keep working unchanged.
discovery.relabel "node" {
	targets = prometheus.exporter.unix.node.targets

	rule {
		target_label = "job"
		replacement  = "node"
	}

	rule {
		target_label = "instance"
		replacement  = string.trim_space(local.file.hostname.content)
	}
}

prometheus.scrape "node" {
	targets         = discovery.relabel.node.output
	scrape_interval = "60s"
	forward_to      = [prometheus.relabel.node.receiver]
}

// Free tier allows 10k active series: drop low-value node series.
prometheus.relabel "node" {
	forward_to = [prometheus.remote_write.grafana_cloud.receiver]

	rule {
		source_labels = ["__name__"]
		regex         = "node_scrape_collector_.*|node_nfs_.*|node_cooling_device_.*|node_systemd_.*"
		action        = "drop"
	}
}

// ---- Container metrics (replaces the standalone cAdvisor) ----
prometheus.exporter.cadvisor "containers" {
	docker_host      = "unix:///var/run/docker.sock"
	storage_duration = "5m"
	enabled_metrics  = ["cpu", "memory", "network", "disk"]
}

discovery.relabel "cadvisor" {
	targets = prometheus.exporter.cadvisor.containers.targets

	rule {
		target_label = "job"
		replacement  = "cadvisor"
	}

	rule {
		target_label = "instance"
		replacement  = string.trim_space(local.file.hostname.content)
	}
}

prometheus.scrape "cadvisor" {
	targets         = discovery.relabel.cadvisor.output
	scrape_interval = "60s"
	forward_to      = [prometheus.relabel.cadvisor.receiver]
}

// Keep only container-level series that carry a container name, and drop
// per-device/per-failure series that dominated the old cAdvisor cardinality.
prometheus.relabel "cadvisor" {
	forward_to = [prometheus.remote_write.grafana_cloud.receiver]

	rule {
		source_labels = ["__name__", "name"]
		regex         = "container_.*;"
		action        = "drop"
	}

	rule {
		source_labels = ["__name__"]
		regex         = "container_(blkio_device_usage_total|tasks_state|memory_failures_total|fs_(reads|writes)(_bytes)?_total|fs_(read|write)_seconds_total|fs_io_.*|fs_sector_.*|fs_(reads|writes)_merged_total)"
		action        = "drop"
	}
}
